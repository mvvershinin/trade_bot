# --- Секреты ---
# Токен — это доступ к счёту на срок до 90 дней. Правила ниже не должны
# зависеть от имени файла, которое ещё никто не выбрал: место рантайм-данных
# фиксируется до первой строки `app/` (см. ROADMAP.md, Э1-4).
# Всё, что программа создаёт сама, живёт в одной папке. Она и закрывается —
# целиком, одним правилом. Решение 0003.
/userdata/

# Переменные окружения и ключи — по расширению или точному имени.
.env
.env.*
.envrc
*.pem
*.key
*.p12
*.pfx
*.dmp

# Исключение: тестовые фикстуры. Поддельный сертификат и заведомо фальшивый ключ —
# это то, ЧЕМ доказывается, что токен не утекает в лог. Без этой строки такой тест
# зеленеет у автора и падает в свежем клоне с FileNotFoundError.
# Коммит фикстуры с расширением ключа — осознанное действие, а не случайность.
!tests/fixtures/**

# Файлы данных с секретами — на любой глубине. Расширение здесь не даёт
# перепутать их с продуктовым кодом: `.json`/`.ini`/`.txt`, а не `.py`.
**/token.json
**/token.ini
**/token.txt
**/tokens.json
**/secret.json
**/secrets.json
**/credential.json
**/credentials.json

# Правила по подстроке ЯКОРНЫЕ, только корень рабочей копии.
# Без якоря `*token*` совпадает на любой глубине и молча прячет продуктовый код:
# `broker/token_store.py`, `ui/token_dialog.py`, `tests/test_token_refresh.py`,
# `app/credential_vault.py`, `.docs/TOKEN.md`. Это опаснее исходной дыры —
# предохранитель уезжает в сборку с диска разработчика, минуя ревью и историю.
# Классы символов, а не перечисление вариантов: забыть регистр больше нельзя.
# `SECRET`, `Credentials` и подобные проходили мимо перечисления.
/*[tT][oO][kK][eE][nN]*
/*[sS][eE][cC][rR][eE][tT]*
/*[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]*
/*[kK][eE][yY][sS]*

# Кириллица: git сворачивает регистр побайтово по ASCII, многобайтовые буквы
# он не свернёт — поэтому варианты перечислены явно. Проект русскоязычный,
# и черновик с живым токеном скорее назовут «токен.txt», чем «token.txt».
/*токен*
/*Токен*
/*ТОКЕН*
/*ключ*
/*Ключ*
/*секрет*
/*Секрет*

# --- Локальный архив-эталон: целиком вне git ---
# Не из-за веса. Внутри — рабочие доступы, ключи и внутренняя топология
# рабочего окружения, а также материалы, из которых перенесена стратегия.
# Файлы остаются на диске и доступны агентам локально, но не коммитятся.
# НИКОГДА не делать `git add -f` на пути внутри этой папки.
/reference/

# --- ТЗ заказчика ---
# Полное ТЗ: стратегия, замеренные цифры прибыли, брокер, тарифы, инструмент.
# Коммерческая информация владельца счёта. Рабочее знание вынесено в DOMAIN.md,
# ARCHITECTURE.md, PROTOTYPE.md, QUALITY.md — они в git и самодостаточны.
/.docs/SPEC.md*
/.docs/.SPEC.md.*

# Спутники редакторов и слияний: содержат текст файла целиком.
# Правило `/.docs/SPEC.md` закрывало ровно один путь — `.docs/.SPEC.md.swp`
# с полным текстом ТЗ проходил в индекс мимо проверки.
*~
*.orig
*.rej
.*.sw?
# Автосохранение Emacs `#файл#` несёт полный текст буфера, файл-замок `.#файл` —
# имя пользователя и хоста. Решётку обязательно экранировать: строка, начинающаяся
# с `#`, для git комментарий, и правило молча не действует.
\#*\#
.\#*

# Локальные настройки харнесса: у каждой машины свои, в git не идут.
# Сейчас файл прячется только глобальным ~/.config/git/ignore этой машины —
# на другой машине и в CI он попал бы в индекс.
.claude/settings.local.json

# Метки дедупликации напоминаний docs-reminder.sh: по одной на файл за сессию.
# Якорное правило на каталог, а не по имени файла — имена там хеши, и правило
# по имени промахнулось бы (тот же довод, что в решении 0003 про userdata/).
/.claude/.state/


# --- Данные и сборки ---
# Правила якорные. Без якоря `dist/` прятал бы вендоренную библиотеку графика
# (`ui/web/vendor/.../dist/*.js`), а `*.db` — синтетические фикстуры тестов:
# git при этом молчит, и «у меня работает» обнаруживается в свежем клоне.
/*.db
/*.sqlite
/*.sqlite3
/dist/
/build/
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- Служебное ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Артефакты сборки Nuitka и AppImage ---
# `.spec` PyInstaller в git ОСТАЁТСЯ намеренно: запасной путь сборки обязан
# оставаться рабочим, а не протухнуть. Игнорируются только результаты сборки.
*.build/
*.dist/
*.onefile-build/
# Иконка собирается кодом (`tools/make_icon.py`) и пересобирается сама,
# когда её нет: `tools/build.py` зовёт генератор перед сборкой под Windows.
# В git не хранится — двоичный файл, происхождение которого никто не помнит,
# хуже тридцати строк, которые его делают.
/tools/terminal.ico
nuitka-crash-report.xml
compilation-report.xml
*.egg-info/
*.so
*.pyd
*.exe
*.AppImage
AppDir/

# --- Что создаёт сама программа при первом запуске ---
# Файл базы уже закрыт правилами *.db / *.sqlite выше; здесь — её спутники и логи.
/*.db-journal
/*.db-wal
/*.db-shm
/*.sqlite-journal
/*.sqlite-wal
/*.sqlite-shm
/*.sqlite3-*
/*.log
/logs/

# --- Отчёты сверки: в git идут только отчёты в Markdown ---
# Сырые выгрузки прогонов (JSON, CSV и прочее) остаются на диске и не коммитятся.
# Каталоги возвращаются отдельным правилом: gitignore не умеет доставать файл
# из исключённого каталога, и отчёт в `parity/ГГГГ-ММ-ДД/` пропадал бы молча.
.docs/parity/**
!.docs/parity/**/
!.docs/parity/**/*.md

# --- Отчёты агентов: в git идут только доказательства приёмки ---
# Полные разборы агентов переехали в файлы 03.09.2026: в диалог возвращается
# выжимка, всё остальное пишется под `.docs/`. Отчётов будет много — по одному
# на каждый прогон роли, — и коммитить их все значило бы утопить историю правок
# продукта в рабочих материалах сессий.
#
# Правило разделения — не «шумные и полезные», а **чем этот файл является**:
#
#   * `parity/` и `risk/` — ДОКАЗАТЕЛЬСТВА. Сверка сделка в сделку закрывает
#     главный пункт приёмки ТЗ §9, аудит денег — пункты `/go-live`. На них
#     ссылаются решения и план, и через полгода вопрос «когда это проверяли»
#     обязан иметь ответ в репозитории. Коммитятся, как и было.
#   * остальные — РАБОЧИЙ МАТЕРИАЛ одной сессии. Их выводы всё равно переносятся
#     в `ROADMAP.md` и в `decisions/`; сам разбор нужен, пока задача в работе.
#     Лежат на диске, в git не идут.
#
# Каталоги возвращаются отдельным правилом по той же причине, что у сверки:
# gitignore не умеет доставать файл из исключённого каталога.
.docs/reviews/**
.docs/validate/**
.docs/coordination/**
.docs/strategy/**
.docs/backtest/**
.docs/broker/**
.docs/data/**
.docs/ui/**
.docs/packaging/**
.docs/product/**
.docs/domain/**
.docs/tests/**

.docs/risk/**
!.docs/risk/**/
!.docs/risk/**/*.md

# Конфигурация IDE: личные пути, состояние окон, список открытых файлов.
.idea/
