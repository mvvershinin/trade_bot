{
  "hooks": {
    "PreToolUse": [{
      "matcher": "^Bash$",
      "hooks": [{
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/guard.py\" pre",
        "timeout": 25
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/guard.py\" finish",
        "timeout": 10
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/guard.py\" finish",
        "timeout": 10
      }]
    }]
  }
}
